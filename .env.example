# ── Graph database (CognoDB Cloud in prod, Neo4j in local dev — both speak Bolt/Cypher) ──
# Local dev (docker-compose): bolt://localhost:7687
# CognoDB Cloud:              bolt+s://<instance-id>.databases.cognodb.cloud
GRAPH_URI=bolt://localhost:7687
GRAPH_USER=neo4j
GRAPH_PASSWORD=agentgraph_dev_password
GRAPH_DATABASE=neo4j

# ── Relational store (app-side metadata: saved views, background job audit log) ──
POSTGRES_URL=postgres://agentgraph:agentgraph_dev_password@localhost:5432/agentgraph

# ── Redis / BullMQ (async analysis jobs: similarity recompute, impact reports) ──
REDIS_URL=redis://localhost:6379

# ── API ──
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# ── Web ──
VITE_API_URL=http://localhost:3001
